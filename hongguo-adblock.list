# Keep this exception above the wildcard rejection rule.
HOST,p3-ad-sign.byteimg.com,DIRECT

# Hongguo / related ByteDance reading ad resources
HOST-WILDCARD,*-misc-lq.fqnovel.com,REJECT
HOST-WILDCARD,*-reading-ad.qznovelvod.com,REJECT
HOST-WILDCARD,*-ad-sign.byteimg.com,REJECT
HOST-WILDCARD,*-iosreadingvideo.qznovelvod.com,REJECT
